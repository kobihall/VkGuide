#version 460

// GPU path tracer, stage 2: intersect every queued path with the scene. The designated swap
// point: a triangle/BVH extend over the glTF mesh data writes the same HitRecord (world
// position, ray-facing normal, material, face bit) and shade never knows the difference.
//
// Spheres only, a linear scan: the scene is a handful of user-placed spheres.

#extension GL_GOOGLE_include_directive : require
#include "crt_common.glsl"

layout (local_size_x = CRT_WORKGROUP) in;

void main()
{
	const uint queue = pc.bounce & 1u;
	const uint index = gl_GlobalInvocationID.x;
	// no barriers in this stage, so the overhang of the last workgroup can simply leave
	if (index >= headers[queue].rayCount) {
		return;
	}

	const uint pathIndex = queues[queueSlot(queue, index)];
	const PathState path = paths[pathIndex];

	const vec3 origin = path.origin;
	const vec3 direction = normalize(path.direction);

	float closest = CRT_INFINITY;
	int hitIndex = -1;
	for (uint s = 0u; s < pc.sphereCount; s++) {
		float t;
		if (hitSphere(spheres[s], origin, direction, CRT_T_MIN, closest, t)) {
			closest = t;
			hitIndex = int(s);
		}
	}

	HitRecord record;
	if (hitIndex < 0) {
		record.position = vec3(0.0);
		record.t = -1.0;
		record.normal = vec3(0.0);
		record.materialAndFace = 0u;
	} else {
		const GpuSphere s = spheres[hitIndex];
		record.position = origin + closest * direction;
		record.t = closest;
		// the stored normal always faces the incoming ray; the bit records which side was hit
		const vec3 outward = (record.position - s.center) / s.radius;
		const bool frontFace = dot(direction, outward) < 0.0;
		record.normal = frontFace ? outward : -outward;
		record.materialAndFace = (uint(hitIndex) << 1u) | (frontFace ? 1u : 0u);
	}

	hits[index] = record;
}
