#version 460

// 06 Sample Surface Scattering - LIGHT SAMPLING. Every light is reached through a shadow ray, at full
// weight, and the path continues along a BSDF sample whose light counts only where no light sample
// could have gone (after a specular bounce, or on an emitter outside the light list).
// The body is crt_surface.glsl; see there for what the three strategies share.

#extension GL_GOOGLE_include_directive : require
#define CRT_DIRECT_LIGHTING 1
#include "include/crt_common.glsl"
#include "include/crt_random.glsl"
#include "equirect.glsl"
#include "include/crt_scatter.glsl"
#include "include/crt_light.glsl"
#include "include/crt_debug.glsl"
#include "include/crt_surface.glsl"
