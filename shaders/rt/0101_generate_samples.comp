#version 460

// 01 GENERATE SAMPLES - PCG PER BOUNCE. Runs at the top of every bounce, over the ray queue that
// bounce will trace, and prepares each live path's sample state for the dimensions that bounce is
// about to consume.
//
// This variant decorrelates the path's PCG state with the bounce index and writes no sample record:
// the draws themselves - the BSDF sample, the light sample - happen lazily inside kernel 06, straight
// out of PathState.rngState, and a stream that is a pure function of (pixel, sample index, render
// seed, bounce) reproduces an image exactly from a fixed seed no matter how the queues were ordered
// or the workgroups scheduled. It is what a scene saved before the samplers existed runs, and it
// renders bit-identically to the tracer of that time.
//
// The other variants, 0102 to 0108, are the samplers: they write each path's RaySamples record
// (crt_samples.glsl) from a stratified, Halton, Sobol or PMJ02BN point for (pixel, sample index,
// bounce), as pbrt-v4's wavefront does in a kernel of its own (PBR 4ed 15.3.5). Their body is
// crt_sampler.glsl.
//
// NOTE: the hash below changes which random numbers a given path draws, so the noise pattern
// differs from the pre-refactor tracer. The estimator is unchanged and the converged image is
// identical - only the path to it is a different random walk.

#extension GL_GOOGLE_include_directive : require
#include "include/crt_common.glsl"
#include "include/crt_random.glsl"

layout (local_size_x = CRT_WORKGROUP) in;

void main()
{
	const uint queue = rayQueueFor(pc.bounce);
	const uint index = gl_GlobalInvocationID.x;
	// no queueAppend() here, so the overhang of the last workgroup can simply leave
	if (index >= headers[queue].rayCount) {
		return;
	}

	const uint pathIndex = queues[queueSlot(queue, index)];
	// one round of the same PCG the rest of the tracer uses, mixing in the bounce so that two
	// bounces of one path never walk the same stretch of the stream
	paths[pathIndex].rngState = pcgHash(paths[pathIndex].rngState ^ pcgHash(pc.bounce));
}
