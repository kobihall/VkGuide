#version 460

// 03 HANDLE ESCAPED. The paths kernel 02 pushed onto CRT_QUEUE_ESCAPED: rays that left the
// scene without hitting anything. Each one collects the background through everything it
// bounced off, weighted by the MIS record the vertex before it left, and ends there.
//
//     L += throughput * background(direction) * w
//
// The environment map is a light like any other once kernel 06 samples it (pbrt-v4's
// ImageInfiniteLight): w follows PathState.misPdf exactly as in kernel 04, with the light sampling's
// density taken from the table 06 drew from - the MIS-compensated one under MIS, the full one under
// light sampling alone. A solid colour or the sky gradient is not in the light list, so it keeps
// w = 1 whatever the strategy.
//
// A path only ever reaches this kernel once, and never continues afterwards, so nothing is
// appended to the next ray queue and the last workgroup's overhang can simply return.

#extension GL_GOOGLE_include_directive : require
#include "include/crt_common.glsl"
#include "include/crt_random.glsl"
#include "equirect.glsl"
#include "include/crt_background.glsl"
#include "include/crt_light.glsl"
#include "include/crt_debug.glsl"

layout (local_size_x = CRT_WORKGROUP) in;

void main()
{
	const uint index = gl_GlobalInvocationID.x;
	if (index >= headers[CRT_QUEUE_ESCAPED].rayCount) {
		return;
	}

	// the queue holds the RAY QUEUE POSITION, which is also the index of the path's hit record
	const uint entry = queues[queueSlot(CRT_QUEUE_ESCAPED, index)];
	const uint pathIndex = queues[queueSlot(rayQueueFor(pc.bounce), entry)];
	const PathState path = paths[pathIndex];
	const HitRecord hit = hits[entry];
	const vec3 inDir = normalize(path.direction);

	vec3 value;
	if (debugTerminalValue(hit, inDir, false, value)) {
		radiance[path.radianceSlot] = vec4(value, 1.0);
		return;
	}
	if (pc.debugView == CRT_DEBUG_BOUNCE_HEAT) {
		radiance[path.radianceSlot] = vec4(bounceHeat(path.bounce), 1.0);
		return;
	}

	// the MIS weight of the environment found by the BSDF sample, against light sampling
	float weight = 1.0;
	if (path.misPdf >= 0.0 && lightHeader.environment != CRT_NO_LIGHT) {
		const uint table = path.misPdf > 0.0 ? 1u : 0u;
		const float lightPdf = lightPmf(lightHeader.environment) * environmentPdf(table, inDir);
		if (lightPdf > 0.0) {
			weight = misWeight(path.misPdf, lightPdf, path.misExponent);
		}
	}

	// the MIS weights view: the first vertex's direct light found by its BSDF sample, in red. The
	// background seen straight from the camera belongs to neither technique
	if (pc.debugView == CRT_DEBUG_MIS_WEIGHTS) {
		if (path.bounce == 1u) {
			radiance[path.radianceSlot].rgb += vec3(dot(path.throughput * backgroundRadiance(inDir) * weight, vec3(0.2126, 0.7152, 0.0722)), 0.0, 0.0);
		}
		return;
	}

	// added, not written: the path may have passed glowing surfaces on earlier bounces. The weight
	// is applied only when it is not 1, so a strategy without light sampling adds exactly what it
	// always did
	vec3 contribution = path.throughput * backgroundRadiance(inDir);
	if (weight != 1.0) {
		contribution *= weight;
	}
	radiance[path.radianceSlot].rgb += contribution;
}
