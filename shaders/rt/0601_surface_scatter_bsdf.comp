#version 460

// 06 Sample Surface Scattering - BSDF SAMPLING. A light counts only when the material's own sample
// happens to hit it, at full weight; only the delta lights, which no BSDF sample can hit, get shadow
// rays. The strategy's other half is kernels 03 and 04 taking whatever the path finds in full.
// The body is crt_surface.glsl; see there for what the three strategies share.

#extension GL_GOOGLE_include_directive : require
#define CRT_DIRECT_LIGHTING 0
#include "include/crt_common.glsl"
#include "include/crt_interaction.glsl"
#include "include/crt_random.glsl"
#include "equirect.glsl"
#include "include/crt_scatter.glsl"
#include "include/crt_light.glsl"
#include "include/crt_debug.glsl"
#include "include/crt_surface.glsl"
