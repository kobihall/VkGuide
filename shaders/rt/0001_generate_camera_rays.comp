#version 460

// 00 GENERATE CAMERA RAYS. One invocation per (pixel, k) pair of the path pool; those under the
// pixel's budget become paths appended to the first ray queue. Runs once per frame, before the
// bounce loop - every kernel after this one runs once per bounce.
//
// Every slot's radiance is pre-written so that a path which dies without writing (roulette, the
// depth cap, absorption) contributes exactly zero, and a slot that was never spawned is marked
// as such for kernel 09.
//
// The camera is RTCamera (src/rt_job.cpp) in float: same origin, lower-left corner, horizontal
// and vertical vectors, same lens basis, so both backends fire the same primary rays.
//
// The offset in the pixel and the position on the lens come from the sample record when the
// selected sampler writes one (kernel 01's camera pass ran just before this); the path's own stream
// is then seeded apart from the record, so that what a later bounce draws from it is independent of
// the camera's numbers.

#extension GL_GOOGLE_include_directive : require
#include "include/crt_common.glsl"
#include "include/crt_random.glsl"
#include "include/crt_samples.glsl"
#include "include/crt_aov.glsl"
#include "include/crt_camera.glsl"
